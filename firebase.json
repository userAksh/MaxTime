{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true }
  },
  "hosting": [
    {
      "target": "website",
      "public": "website/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "!**/.well-known/**"],
      "rewrites": [{ "source": "/r/**", "function": "referralLandingPage" }],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [{ "key": "Content-Type", "value": "application/json" }]
        }
      ]
    },
    {
      "target": "admin-portal",
      "public": "admin-portal/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "partner-portal",
      "public": "partner-portal/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "partner-portal-staging",
      "public": "partner-portal/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "admin-portal-staging",
      "public": "admin-portal/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
