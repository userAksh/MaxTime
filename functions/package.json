{
  "name": "maxtime-functions",
  "version": "1.0.0",
  "private": true,
  "description": "MaxTime Partner/Admin backend — transactional inventory, booking, and payment engine (Firebase Cloud Functions).",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore,auth \"jest\""
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.14",
    "firebase-functions-test": "^3.4.0",
    "@firebase/rules-unit-testing": "^3.0.4"
  }
}
