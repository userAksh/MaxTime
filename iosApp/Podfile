# iosApp.xcodeproj (generated by XcodeGen, see project.yml) defines 5 build configurations for
# the beta/staging/production flavors — without this explicit map, CocoaPods only reliably infers
# Debug vs. Release from the two vanilla config names and can leave the others (or, as seen after
# an Xcode upgrade, even plain Debug/Release) without a generated xcconfig at all, which breaks
# every "[CP] Copy XCFrameworks" script phase (PODS_ROOT ends up undefined in that config).
project 'iosApp.xcodeproj', {
  'Debug' => :debug,
  'Staging' => :debug,
  'Release' => :release,
  'Beta' => :release,
  'Production' => :release
}

target 'iosApp' do
  use_frameworks!
  platform :ios, '15.0'
  pod 'shared', :path => '../shared'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # The shared KMP module only targets iosArm64 + iosSimulatorArm64 (no Intel simulator
      # support) — exclude x86_64 from simulator builds across all pods, otherwise CocoaPods'
      # generated project tries to build it for any config not literally named "Debug"/"Release".
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      # Several pods (gRPC, abseil, leveldb, RecaptchaInterop, razorpay-pod, ...) declare
      # deployment targets as old as 9.0 in their own podspecs. Newer Xcode SDKs stop
      # accepting anything below their own minimum (e.g. Xcode 27's simulator SDK requires
      # 15.0+) and fail the whole build over it — force every pod target up to match the
      # app's own `platform :ios` above instead of relying on each pod to keep up.
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
